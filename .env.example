# WhatsApp Cloud API (Reclutamiento). Mantener en false hasta completar
# la validación del webhook y una prueba controlada con Meta.
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
MSGRAPH_SHAREPOINT_HOST=saepcl.sharepoint.com
MSGRAPH_SHAREPOINT_SITE=PDR
MSGRAPH_ROOT_FOLDER="Actas Vehiculos"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Talana API (solo lectura - producción)
TALANA_API_BASE_URL=https://talana.com/es/api
TALANA_API_AUTH_SCHEME=token
TALANA_API_TOKEN=
TALANA_ALERTA_EMAIL=
TALANA_ALERTA_DIAS=30
# Vacío = toda la nómina activa. Ej.: LTS FLEX QUILICURA EST
TALANA_ASISTENCIA_CENTRO_COSTO=
# Vacío = todas las razones sociales. 1081 corresponde a SAEP EST.
TALANA_ASISTENCIA_EMPRESA_ID=

# Microsoft Graph / SharePoint (OneDrive)
MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
MSGRAPH_SHAREPOINT_HOST=saepcl.sharepoint.com
MSGRAPH_SHAREPOINT_SITE=PDR
MSGRAPH_ROOT_FOLDER="Actas Vehiculos"

# Contratación - SharePoint RRHH
CONTRATACION_SHAREPOINT_SITE=RRH
CONTRATACION_SHAREPOINT_FOLDER="Postulantes Documents"

# Google OAuth (Ley Karin público + Contratación)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/denuncia-ley-karin/auth/callback

# Microsoft Entra ID - Portal de reservas de vehiculos (cuenta corporativa @saep.cl)
VEHICLE_RESERVATION_MICROSOFT_TENANT_ID=
VEHICLE_RESERVATION_MICROSOFT_CLIENT_ID=
VEHICLE_RESERVATION_MICROSOFT_CLIENT_SECRET=
VEHICLE_RESERVATION_MICROSOFT_REDIRECT_URI=https://saep.bmachero.com/reservas-vehiculos/auth/microsoft/callback
VEHICLE_RESERVATION_MICROSOFT_ALLOWED_DOMAIN=saep.cl
VEHICLE_RESERVATION_REQUIRE_APPROVED_REQUESTER=false
VEHICLE_RESERVATION_SAME_DAY_CUTOFF_HOUR=16

# Calendario compartido Microsoft 365 de Bodega. Requiere Calendars.ReadWrite
# de tipo Application en la aplicación configurada con MSGRAPH_*.
VEHICLE_RESERVATION_CALENDAR_ENABLED=false
VEHICLE_RESERVATION_CALENDAR_MAILBOX=
VEHICLE_RESERVATION_CALENDAR_ID=
VEHICLE_RESERVATION_CALENDAR_TIMEZONE="Pacific SA Standard Time"

VITE_APP_NAME="${APP_NAME}"
